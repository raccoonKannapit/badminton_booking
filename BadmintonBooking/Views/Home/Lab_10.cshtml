@{
    ViewData["Title"] = "Lab 10";
    Layout = "_Layout";
}
@model BadmintonBooking.ViewModels.Lab9UserViewModel

<form asp-action="Lab_10" asp-controller="Home" ">
    UserId <input type="text" class="form-control" asp-for="UserId" readonly>
    <br>
    Password <input type="text" class="form-control" asp-for="Password">
    <br>
    Name <input type="text" class="form-control" asp-for="Name">
    <br>
    Lastname <input type="text" class="form-control" asp-for="Lastname">
    <br>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>