@model BadmintonBooking.ViewModels.SettingViewModel
@{
    ViewData["Title"] = "Setting";
    Layout = "_UserLayout";
}

<div class="container mt-4" style="max-width: 860px;">
    <h4 class="mb-4">Settings</h4>
    <div class="row g-0 border rounded overflow-hidden shadow-sm" style="min-height: 420px;">

        <!-- ── Left Sidebar ── -->
        <div class="col-3 border-end" style="background-color: #f4f6fb;">
            <div class="nav flex-column nav-pills p-2 pt-3" id="settingsTabs" role="tablist">
                <button class="nav-link text-start active mb-1" id="tab-account"
                        data-bs-toggle="pill" data-bs-target="#panel-account"
                        type="button" role="tab">
                    Account
                </button>
                <button class="nav-link text-start" id="tab-membership"
                        data-bs-toggle="pill" data-bs-target="#panel-membership"
                        type="button" role="tab">
                    Membership
                </button>
            </div>
        </div>

        <!-- ── Right Content ── -->
        <div class="col-9 p-4">
            <form asp-action="setting" asp-controller="Account" method="post">
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="IsMember" id="isMemberHidden" />

                <div class="tab-content">

                    <!-- Account Panel -->
                    <div class="tab-pane fade show active" id="panel-account" role="tabpanel">
                        <h6 class="mb-3 text-muted text-uppercase" style="font-size: 0.75rem; letter-spacing: .08em;">Account</h6>
                        <div class="mb-3">
                            <label asp-for="Username" class="form-label">Username</label>
                            <input asp-for="Username" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" type="email" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label">Phone</label>
                            <input asp-for="Phone" type="tel" class="form-control" />
                        </div>
                        <div class="mb-4">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" type="text" class="form-control" />
                        </div>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>

                    <!-- Membership Panel -->
                    <div class="tab-pane fade" id="panel-membership" role="tabpanel">
                        <h6 class="mb-3 text-muted text-uppercase" style="font-size: 0.75rem; letter-spacing: .08em;">Membership</h6>
                        <div class="d-flex align-items-center justify-content-between p-3 rounded mb-3"
                             style="background-color: #f0f4ff; border: 1px solid #d0d8f0;">
                            <div>
                                <div class="fw-semibold">Member Status</div>
                                <div class="text-muted small">Members receive exclusive discounts on bookings.</div>
                            </div>
                            <div class="form-check form-switch ms-3 mb-0">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="memberToggle" style="width: 3rem; height: 1.5rem;"
                                       @(Model.IsMember ? "checked" : "")>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>

                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const memberToggle = document.getElementById('memberToggle');
    const isMemberHidden = document.getElementById('isMemberHidden');

    // Sync toggle → hidden input on change
    memberToggle.addEventListener('change', function () {
        isMemberHidden.value = this.checked ? 'true' : 'false';
    });

    // Set initial hidden value from toggle state
    isMemberHidden.value = memberToggle.checked ? 'true' : 'false';
</script>
