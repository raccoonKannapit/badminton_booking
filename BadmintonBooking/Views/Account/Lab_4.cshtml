@* form *@

<div class="container">
    <form asp-controller="Account" asp-action="Lab_4">
        <div class="mb-3">
            <label for="exampleInputEmail1" class="form-label">username</label>
            <input type="text" class="form-control">
        </div>
        <div class="mb-3">
            <label for="exampleInputPassword1" class="form-label">Password</label>
            <input type="password" class="form-control">
        </div>
        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
</div>

<div class="container">
    <form asp-controller="Account" asp-action="Lab_4">
        <div class="row align-items-center mb-3">    
            <div class="col-auto">
                <label for="exampleInputEmail1" class="form-label">username</label>
            </div>
            <div class="col">
                <input type="text" class="form-control">
            </div>
            <button type="submit" class="btn btn-primary">Submit</button>
        </div>
    </form>
</div>

<div class="container">
    <form asp-controller="Account" asp-action="Lab_4">
        <div class="row align-items-center mb-3">    
            <div class="col-auto">
                <label for="exampleInputUsername1" class="form-label">username</label>
            </div>
            <div class="col">
                <input type="text" class="form-control" id="exampleInputUsername1" />
            </div>
            <div class="col-auto">
                <label for="exampleInputPassword1" class="form-label">password</label>
            </div>
            <div class="col">
                <input type="password" class="form-control" id="exampleInputPassword1" />
            </div>
            <div class="col-auto">
                <label for="exampleInputEmail1" class="form-label">email</label>
            </div>
            <div class="col">
                <input type="email" class="form-control" id="exampleInputEmail1" />
            </div>
            <div class="col-auto">
                <label for="exampleInputPhone1" class="form-label">phone</label>
            </div>
            <div class="col">
                <input type="tel" class="form-control" id="exampleInputPhone1" />
            </div>
            <div class="col-auto">
                <label for="exampleInputSearch" class="form-label">Search</label>
            </div>
            <div class="col">
                <input type="search" class="form-control" id="exampleInputSearch" />
            </div>
            <div class="col-auto">
                <label for="exampleInputUrl" class="form-label">Url</label>
            </div>
            <div class="col">
                <input type="url" class="form-control" id="exampleInputUrl" />
            </div>
        </div>
        <div class="row align-items-center mb-3">
            <div class="col-auto">
                <label for="exampleInputfile" class="form-label">File</label>
            </div>
            <div class="col">
                <input type="file" class="form-control" id="exampleInputfile" />
            </div>
        
            <div class="col-auto">
                <label for="exampleInputRadio1" class="form-label">Radio</label>
            </div>
            <div class="col">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="exampleRadio" id="exampleInputRadio1" />
                    <label class="form-check-label" for="exampleInputRadio1">
                        Radio
                    </label>
                </div>
            </div>
            <div class="col-auto">
                <label for="exampleInputCheckbox1" class="form-label">Checkbox</label>
            </div>
            <div class="col">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="exampleCheckbox" id="exampleInputCheckbox1" />
                    <label class="form-check-label" for="exampleInputCheckbox1">
                        Checkbox
                    </label>
                </div>
            </div>
            <div class="col-auto">
                <label for="exampleInputDate1" class="form-label">Date</label>
            </div>
            <div class="col">
                <input type="date" class="form-control" id="exampleInputDate1" />
            </div>
            <div class="col-auto">
                <label for="exampleInputColor1" class="form-label">Color</label>
            </div>
            <div class="col">
                <input type="color" class="form-control" id="exampleInputColor1" />
            </div>
        </div>
    </form>
</div>