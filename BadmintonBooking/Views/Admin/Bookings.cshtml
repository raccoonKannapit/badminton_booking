@{
    ViewData["Title"] = "Admin - All Bookings";
    Layout = "_Admin";
}
@model IEnumerable<_66088226_Kannapich_Baosri.ViewModels.BookingViewModel>

<h2 class="mb-4">All Bookings</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Booking ID</th>
            <th>User ID</th>
            <th>Court</th>
            <th>Date</th>
            <th>Time Slots</th>
            <th>Price</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.BookingId</td>
                <td>@item.UserId</td>
                <td>@item.CourtId</td>
                <td>@item.BookingDate.ToString("dd/MM/yyyy")</td>
                <td>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var slot in item.Slots)
                        {
                            <span class="badge bg-primary">@slot</span>
                        }
                    </div>
                </td>
                <td>@item.Price.ToString("N0") ฿</td>
                <td>
                    <a asp-controller="Admin" asp-action="EditBooking"
                       asp-route-bookingId="@item.BookingId"
                       class="btn btn-sm btn-warning">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>
