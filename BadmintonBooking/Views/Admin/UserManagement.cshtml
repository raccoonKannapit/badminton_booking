@{
    ViewData["Title"] = "User Management";
    Layout = "_Admin";
}
@model IEnumerable<BadmintonBooking.Models.Db.Usersdatum>

<h2 class="mb-4">User Management</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>UserId</th>
            <th>Username</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Role</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.UserId</td>
                <td>@user.Username</td>
                <td>@user.Phone</td>
                <td>@user.Email</td>
                <td>@user.Role</td>
                <td>
                    <a asp-controller="Admin" asp-action="EditUser"
                       asp-route-UID="@user.UserId"
                       class="btn btn-sm btn-primary">Edit</a>
                    <a asp-controller="Admin" asp-action="DeleteUser"
                       asp-route-UID="@user.UserId"
                       class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
