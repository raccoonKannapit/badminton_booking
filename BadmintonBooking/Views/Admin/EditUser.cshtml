@{
    ViewData["Title"] = "Edit User";
    Layout = "_Admin";
}
@model _66088226_Kannapich_Baosri.ViewModels.UserDataViewModel

<div class="container" style="max-width: 500px; margin-top: 50px;">
    <h2 class="mb-4">Edit User</h2>
    <form asp-controller="Admin" asp-action="EditUser" method="post">
        <div class="mb-3">
            <label class="form-label">User ID</label>
            <input type="text" asp-for="UserId" class="form-control" readonly />
        </div>
        <div class="mb-3">
            <label class="form-label">Username</label>
            <input type="text" asp-for="Username" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" asp-for="Email" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Phone</label>
            <input type="tel" asp-for="Phone" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="text" asp-for="Password" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Role</label>
            <select asp-for="Role" class="form-control">
                <option value="1">User</option>
                <option value="2">Admin</option>
                <option value="3">Owner</option>
            </select>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Admin" asp-action="UserManagement"
               class="btn btn-outline-secondary w-50">Cancel</a>
            <button type="submit" class="btn btn-primary w-50">Save</button>
        </div>
    </form>
</div>
